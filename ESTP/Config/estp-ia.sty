\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estp-ia}[2026/04/24 v0.1 Exercices interactifs ESTP (POC)]

%% Dépendances minimales. Les packages suivants sont supposés déjà chargés
%% par configTD.tex (ifthen, environ, mdframed, xcolor). On les re-require
%% ici par sécurité.
\RequirePackage{keyval}
\RequirePackage{qrcode}
\RequirePackage{environ}
\RequirePackage{ifthen}
\RequirePackage{xcolor}
\RequirePackage{mdframed}

%% URL de base vers la SPA interactive. Surchargez-la dans le préambule
%% du TD si besoin, ex. \renewcommand{\ExoIABaseURL}{https://td.mondomaine.fr/exo/}.
\providecommand{\ExoIABaseURL}{https://td.estp.fr/exo/}

%% Dossier racine où le script \inclureExo va chercher les fichiers .tex.
%% Chemin relatif au fichier TD qui appelle \inclureExo.
\providecommand{\ExoRoot}{exercices}

%% Booléen showSolutions : s'il n'a pas été défini par configTD, on le crée
%% à false pour que \begin{Corrige} ne plante pas.
%% \newboolean{showSolutions} définit la macro \ifshowSolutions en interne.
\ifcsname ifshowSolutions\endcsname\else
  \newboolean{showSolutions}
  \setboolean{showSolutions}{false}
\fi

%% Couleur Gray de secours (configTD la définit déjà).
\providecolor{Gray}{HTML}{374151}
%% Couleur du cadre de solution (ThemeLight fournie par configTD).
\providecolor{ThemeLight}{HTML}{E0F2F1}

\makeatletter

%% Métadonnées courantes (réécrites à chaque \ExoMeta).
\newcommand{\estpia@slug}{}
\newcommand{\estpia@titre}{Sans titre}
\newcommand{\estpia@td}{}
\newcommand{\estpia@niveau}{1}

\define@key{estpia}{slug}{\renewcommand{\estpia@slug}{#1}}
\define@key{estpia}{titre}{\renewcommand{\estpia@titre}{#1}}
\define@key{estpia}{td}{\renewcommand{\estpia@td}{#1}}
\define@key{estpia}{niveau}{\renewcommand{\estpia@niveau}{#1}}

%% \ExoMeta{slug=..., titre=..., td=..., niveau=...}
%% Affiche le titre de l'exercice et un QR code pointant vers la SPA.
\newcommand{\ExoMeta}[1]{%
  \setkeys{estpia}{#1}%
  \par\medskip\noindent
  \begin{minipage}[t]{0.78\linewidth}%
    \vspace{0pt}%
    {\Large\bfseries \estpia@titre\par}%
    {\footnotesize\color{Gray}%
      Niveau~\estpia@niveau\ \textbullet\ \texttt{\estpia@slug}\par}%
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.18\linewidth}%
    \vspace{0pt}\raggedleft
    \qrcode[height=1.8cm,level=M]{\ExoIABaseURL\estpia@slug}%
  \end{minipage}%
  \par\vspace{0.4em}%
}

\makeatother

%% \begin{Enonce}...\end{Enonce} : contenu affiché tel quel.
\NewEnviron{Enonce}{\BODY\par}

%% \begin{Corrige}...\end{Corrige} : affiché uniquement si showSolutions=true.
%% On inline le rendu (mdframed) plutôt que d'appeler \begin{solution}, car
%% imbriquer deux environnements \NewEnviron fait boucler environ (\BODY partagé).
\NewEnviron{Corrige}{%
  \ifthenelse{\boolean{showSolutions}}{%
    \vspace{0.5em}%
    \begin{mdframed}[backgroundcolor=ThemeLight,leftmargin=0,rightmargin=0,skipabove=0.2em,skipbelow=0.2em]%
    \textbf{Solution.}\\[0.5em]%
    \BODY
    \end{mdframed}%
    \vspace{0.5em}%
  }{}%
}

%% \begin{Indices}...\end{Indices} : rien dans le PDF (réservé à l'extraction IA).
\NewEnviron{Indices}{}

%% \begin{PlusLoin}...\end{PlusLoin} : rien dans le PDF (réservé à l'extraction IA).
\NewEnviron{PlusLoin}{}

%% \inclureExo{slug} : charge exercices/slug.tex et ajoute un filet de séparation.
\newcommand{\inclureExo}[1]{%
  \input{\ExoRoot/#1.tex}%
  \par\vspace{0.8em}\noindent\hrulefill\par\vspace{0.8em}%
}

\endinput
